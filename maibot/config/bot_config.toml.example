# 麦麦 bot_config.toml 模板
# 使用：复制为 bot_config.toml（部署机 maibot/config/bot_config.toml），按需修改。
# 完整字段见官方仓库 src/config/official_configs.py；首启若缺失会自动生成默认配置。

# WEBUI_HOST 已由 compose 环境变量设为 0.0.0.0；生产环境将 8001 映射到宿主机
# 127.0.0.1:${MAI_WEBUI_PORT:-18001}（仅本机），远程访问走 SSH/VS Code 端口转发，勿改公网暴露。

[maim_message]
# Legacy WS server —— qqbot 的 mai_bridge 插件以 MessageClient 身份连入此端口
ws_server_host = "0.0.0.0"
ws_server_port = 8000
# 与 nonebot 侧 MAI_AUTH_TOKEN 保持一致；留空表示不鉴权（不建议）
auth_token = ["change-me-bridge-token"]

# 新版 API Server 无需开启（桥接走 legacy 协议）
enable_api_server = false

# 内网桥接拓扑中，麦麦不直接连接 QQ，无需配置 NapCat 相关项

[bot]
# 备用主平台与账号：Platform IO 依据它注册发送路由。
# 若留空，麦麦回复时报 "未命中任何发送路由"，消息发不出桥。
platform = "qqbot"        # 与桥接端 MAI_PLATFORM_NAME 一致
qq_account = "3657737560" # 机器人 QQ（与 BOT_QQ 一致）

[chat]
# 群聊回复意愿等行为参数保持官方默认即可；
# 想让麦麦更活跃/更沉默可微调 replyer 相关概率配置（详见官方文档）

[inner]
# 配置文件内部版本标记（与镜像版本一致，供 MaiMBot 做迁移判断；缺失会启动失败）
version = "1.2.3"
