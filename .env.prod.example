COMPOSE_PROJECT_NAME=qqbot-prod
COMPOSE_PROJECT_NAME=qqbot-prod
COMPOSE_PROFILES=qq
MYSQL_IMAGE=mysql:8.0
NAPCAT_IMAGE=
NONEBOT_IMAGE=
FRONTEND_IMAGE=
DB_ROOT_PASSWORD=
DB_NAME=qqbot
DB_USER=qqbot
DB_PASSWORD=
ONEBOT_ACCESS_TOKEN=
BOT_QQ=
GROUP_ID=
LOG_LEVEL=INFO
COOLDOWN_DURATION=1
OBSERVABILITY_QUEUE_CAPACITY=2048
OBSERVABILITY_BATCH_SIZE=50
OBSERVABILITY_FLUSH_INTERVAL_SECONDS=0.5
OBSERVABILITY_SHUTDOWN_TIMEOUT_SECONDS=10
OBSERVABILITY_RETENTION_DAYS=30
OBSERVABILITY_RETENTION_INTERVAL_HOURS=24
OBSERVABILITY_SYSTEM_SAMPLE_SECONDS=5
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=80
NAPCAT_BIND_IP=127.0.0.1
NAPCAT_ADMIN_PORT=3000
NAPCAT_WEBUI_PORT=6099
IMAGES_PATH=./images
LOGS_PATH=./logs

# MaiBot (麦麦) 桥接（可选）—— 启用：COMPOSE_PROFILES=qq,mai
# 镜像默认 sengokucola/maibot:v1.2.3（已固定版本）；升级时改为新 tag，勿用 latest
# LLM API Key 写在 maibot/config/model_config.toml 中（不要写进 env）
MAI_ENABLED=false
MAI_IMAGE=
MAI_AUTH_TOKEN=
MAI_ALLOWED_GROUPS=
MAI_MIN_INTERVAL_SECONDS=10
MAI_MAX_REPLY_LENGTH=1500
TZ=Asia/Shanghai
