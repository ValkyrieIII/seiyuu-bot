COMPOSE_PROJECT_NAME=qqbot-dev
APP_ENV=development
MYSQL_IMAGE=mysql:8.0
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
DB_ROOT_PASSWORD=dev-root-password
DB_NAME=qqbot_dev
DB_USER=qqbot_dev
DB_PASSWORD=dev-app-password
MYSQL_PORT=3307
NONEBOT_PORT=8080
FRONTEND_PORT=5173
ONEBOT_ACCESS_TOKEN=dev-only-onebot-token
BOT_QQ=
GROUP_ID=
LOG_LEVEL=DEBUG
COOLDOWN_DURATION=1
VITE_USE_MOCK=false
NAPCAT_ADMIN_PORT=3000
NAPCAT_WS_PORT=3001
NAPCAT_WEBUI_PORT=6099

# MaiBot (麦麦) 桥接 —— 启用方式：COMPOSE_PROFILES=qq,mai 且 MAI_ENABLED=true
# 注意：MAI_ENABLED 开启前需要先在麦麦侧配置好 LLM API Key（maibot/config/model_config.toml）
MAI_ENABLED=false
MAI_IMAGE=sengokucola/maibot:1.2.3
MAI_AUTH_TOKEN=dev-only-mai-token
MAI_ALLOWED_GROUPS=
MAI_MAX_REPLY_LENGTH=1500
TZ=Asia/Shanghai
